{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "api/*": ["./libs/api/*/index.ts"],
      "components": ["./libs/components/index.ts"],
      "components/*": ["./libs/components/*/index.ts"],
      "fixtures/*": ["./libs/fixtures/*/index.ts"],
      "pages/*": ["./libs/pages/*/index.ts"],
      "steps/*": ["./libs/steps/*/index.ts"],
      "test-data": ["./libs/test-data/index.ts"],
      "utils": ["./libs/utils/index.ts"]
    }
  }
}
